  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Generate random Iranian phone number for new test runs",
          "function generateRandomIranianPhone() {",
          "    const prefixes = ['910', '911', '912', '913', '914', '915', '916', '917', '918', '919',",
          "                     '990', '991', '992', '993', '994',",
          "                     '920', '921', '922', '923', '924', '925', '926', '927', '928', '929',",
          "                     '930', '931', '932', '933', '934', '935', '936', '937', '938', '939',",
          "                     '901', '902', '903', '904', '905'];",
          "    const randomPrefix = prefixes[Math.floor(Math.random() * prefixes.length)];",
          "    const randomNumber = Math.floor(Math.random() * 10000000).toString().padStart(7, '0');",
          "    return '+98' + randomPrefix + randomNumber;",
          "}",
          "",
          "// Only generate new phone number if we're starting a fresh test",
          "if (!pm.collectionVariables.get('phoneNumber') || pm.collectionVariables.get('phoneNumber').startsWith('+989203020409')) {",
          "    const newPhoneNumber = generateRandomIranianPhone();",
          "    pm.collectionVariables.set('phoneNumber', newPhoneNumber);",
          "    console.log('📱 Generated random phone number:', newPhoneNumber);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "📱 1. Mobile Registration",
      "description": "Register new users with phone number and SMS verification",
      "item": [
        {
          "name": "Get Registration Flow",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('registrationFlowId', response.id);",
                  "    // Extract CSRF token from the response",
                  "    const csrfNode = response.ui.nodes.find(node => node.attributes.name === 'csrf_token');",
                  "    if (csrfNode && csrfNode.attributes.value) {",
                  "        pm.collectionVariables.set('csrfToken', csrfNode.attributes.value);",
                  "        console.log('🔒 CSRF Token extracted:', csrfNode.attributes.value);",
                  "    } else {",
                  "        console.log('⚠️ No CSRF token found in response, using empty string');",
                  "        pm.collectionVariables.set('csrfToken', '');",
                  "    }",
                  "    console.log('📋 Registration Flow ID:', response.id);",
                  "    console.log('⏰ Flow expires at:', response.expires_at);",
                  "} else {",
                  "    console.log('❌ Failed to get registration flow');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/self-service/registration/api",
              "host": ["{{baseUrl}}"],
              "path": ["self-service", "registration", "api"]
            }
          },
          "response": []
        },
        {
          "name": "Submit Registration - Request SMS Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 400) {",
                  "    const response = pm.response.json();",
                  "    if (response.state === 'sent_email') {",
                  "        console.log('📱 SMS code sent successfully!');",
                  "        console.log('📱 Phone:', response.ui.nodes[1].attributes.value);",
                  "        console.log('📝 Get code with: docker-compose logs kratos | grep registration_code');",
                  "        console.log('⏰ Code expires in 10 minutes');",
                  "    } else {",
                  "        console.log('❌ Registration request failed');",
                  "        console.log('Response:', JSON.stringify(response, null, 2));",
                  "    }",
                  "} else {",
                  "    console.log('❌ Failed to submit registration');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"method\": \"code\",\n    \"traits\": {\n      \"phone\": \"{{phoneNumber}}\"\n    },\n    \"channel\": \"sms\",\n    \"csrf_token\": \"{{csrfToken}}\"\n  }"
            },
            "url": {
              "raw": "{{baseUrl}}/self-service/registration?flow={{registrationFlowId}}",
              "host": ["{{baseUrl}}"],
              "path": ["self-service", "registration"],
              "query": [
                {
                  "key": "flow",
                  "value": "{{registrationFlowId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Submit Registration - Verify SMS Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 400) {",
                  "    const response = pm.response.json();",
                  "    if (response.identity) {",
                  "        pm.collectionVariables.set('newUserId', response.identity.id);",
                  "        pm.collectionVariables.set('newUserPhone', response.identity.traits.phone);",
                  "        console.log('✅ NEW USER CREATED!');",
                  "        console.log('👤 User ID:', response.identity.id);",
                  "        console.log('📱 Phone:', response.identity.traits.phone);",
                  "        console.log('📊 State:', response.identity.state);",
                  "        console.log('🎉 Registration complete!');",
                  "    } else if (response.state === 'passed_challenge') {",
                  "        console.log('✅ EXISTING USER VERIFIED!');",
                  "        console.log('📱 Phone number verified and active');",
                  "        console.log('🎉 User authenticated via code!');",
                  "    } else {",
                  "        console.log('❌ Verification failed');",
                  "        console.log('🔍 Check:');",
                  "        console.log('1. Is verification code correct?');",
                  "        console.log('2. Did you get the latest code from logs?');",
                  "        console.log('3. Command: docker-compose logs kratos | grep registration_code');",
                  "        console.log('4. Code format: 6-digit number');",
                  "        console.log('Response:', JSON.stringify(response, null, 2));",
                  "    }",
                  "} else {",
                  "    console.log('❌ Failed to submit verification');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
