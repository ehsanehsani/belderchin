    {
      "name": "🎮 4. Session Management",
      "description": "Check current session and logout functionality",
      "item": [
        {
          "name": "Get Current Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.active) {",
                  "        console.log('✅ SESSION ACTIVE');",
                  "        console.log('👤 User ID:', response.identity.id);",
                  "        console.log('📱 Phone:', response.identity.traits.phone);",
                  "        console.log('📊 State:', response.identity.state);",
                  "        console.log('🔐 AAL:', response.authenticator_assurance_level);",
                  "        console.log('⏰ Expires:', response.expires_at);",
                  "        console.log('📱 Auth Methods:', JSON.stringify(response.authentication_methods, null, 2));",
                  "    } else {",
                  "        console.log('❌ NO ACTIVE SESSION');",
                  "        console.log('🔄 Please login first');",
                  "    }",
                  "} else if (pm.response.code === 401) {",
                  "    console.log('❌ SESSION EXPIRED OR INVALID');",
                  "    console.log('🔄 Please login again');",
                  "} else {",
                  "    console.log('❌ Failed to check session');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions/whoami",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "whoami"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✅ LOGOUT SUCCESSFUL');",
                  "    console.log('🔄 Session cleared');",
                  "    pm.collectionVariables.unset('sessionToken');",
                  "    pm.collectionVariables.unset('sessionId');",
                  "    console.log('🧹 Variables cleared');",
                  "} else {",
                  "    console.log('❌ Logout failed');",
                  "    console.log('Response:', JSON.stringify(pm.response.json(), null, 2));",
                  "}"
                ]
              }
            }
