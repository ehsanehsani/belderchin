              "mode": "raw",
              "raw": "{\n    \"method\": \"code\",\n    \"traits\": {\n      \"phone\": \"{{phoneNumber}}\"\n    },\n    \"code\": \"{{verificationCode}}\",\n    \"csrf_token\": \"{{csrfToken}}\"\n  }"
            },
