  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Generate random Iranian phone number for new test runs",
          "function generateRandomIranianPhone() {",
          "    const prefixes = ['910', '911', '912', '913', '914', '915', '916', '917', '918', '919',",
          "                     '990', '991', '992', '993', '994',",
          "                     '920', '921', '922', '923', '924', '925', '926', '927', '928', '929',",
          "                     '930', '931', '932', '933', '934', '935', '936', '937', '938', '939',",
          "                     '901', '902', '903', '904', '905'];",
          "    const randomPrefix = prefixes[Math.floor(Math.random() * prefixes.length)];",
          "    const randomNumber = Math.floor(Math.random() * 10000000).toString().padStart(7, '0');",
          "    return '+98' + randomPrefix + randomNumber;",
          "}",
          "",
          "// Generate random test email",
          "function generateTestEmail() {",
          "    const timestamp = Date.now();",
          "    return `test${timestamp}@example.com`;",
          "}",
          "",
          "// Only generate new phone/email if we're starting a fresh test",
          "if (!pm.collectionVariables.get('phoneNumber') || pm.collectionVariables.get('phoneNumber').startsWith('+989203020409')) {",
          "    const newPhoneNumber = generateRandomIranianPhone();",
          "    const newEmail = generateTestEmail();",
          "    pm.collectionVariables.set('phoneNumber', newPhoneNumber);",
          "    pm.collectionVariables.set('email', newEmail);",
          "    console.log('📱 Generated random phone number:', newPhoneNumber);",
          "    console.log('📧 Generated random email:', newEmail);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "📱 1. Registration (Auth-Bridge Standalone)",
      "description": "Register users with Auth-Bridge verification and session management",
      "item": [
        {
          "name": "Start Registration - Auth-Bridge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('registrationId', response.id);",
                  "    console.log('✅ Registration started!');",
                  "    console.log('🆔 Registration ID:', response.id);",
                  "    console.log('📡 Delivery method:', response.delivery);",
                  "    console.log('📝 Message:', response.message);",
                  "    if (response.delivery === 'email') {",
                  "        console.log('📧 Check MailHog at: http://localhost:8025');",
                  "        console.log('📧 Email sent to:', response.email);",
                  "        // Auto-extract code from MailHog after 2 seconds delay",
                  "        setTimeout(() => {",
                  "            pm.sendRequest({",
                  "                url: '{{mailHogUrl}}/api/v2/messages',",
                  "                method: 'GET',",
                  "                header: ['Accept: application/json'],",
                  "                body: null",
                  "            }, (err, res) => {",
                  "                if (!err && res.code === 200) {",
                  "                    const mailResponse = res.json();",
                  "                    if (mailResponse.total > 0 && mailResponse.items[0]) {",
                  "                        const body = mailResponse.items[0].Content.Body;",
                  "                        const codeMatch = body.match(/\\b(\\d{6})\\b/);",
                  "                        if (codeMatch) {",
                  "                            const extractedCode = codeMatch[1];",
                  "                            pm.collectionVariables.set('registrationCode', extractedCode);",
                  "                            console.log('🔢 AUTO-EXTRACTED REGISTRATION CODE:', extractedCode);",
                  "                            console.log('🎯 Ready for registration verification!');",
                  "                        } else {",
                  "                            console.log('⚠️ No code found in email body');",
                  "                            console.log('📧 Email body:', body);",
                  "                        }",
                  "                    } else {",
                  "                        console.log('❌ No emails found in MailHog');",
                  "                    }",
                  "                }",
                  "            });",
                  "        }, 2000);",
                  "    } else {",
                  "        console.log('📱 SMS sent to:', pm.collectionVariables.get('phoneNumber'));",
                  "    }",
                  "} else {",
                  "    console.log('❌ Failed to start registration');",
                  "    console.log('Response:', JSON.stringify(pm.response.json(), null, 2));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"{{phoneNumber}}\",\n    \"email\": \"{{email}}\"\n  }"
            },
            "url": {
              "raw": "{{authBridgeUrl}}/verification/start",
              "host": ["{{authBridgeUrl}}"],
              "path": ["verification", "start"]
            }
          },
          "response": []
        },
        {
