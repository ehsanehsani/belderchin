    {
      "name": "📧 5. MailHog Tools",
      "description": "Tools for checking MailHog and retrieving verification codes",
      "item": [
        {
          "name": "Check MailHog Messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    console.log('📧 MailHog Status:');",
                  "    console.log('📊 Total messages:', response.total);",
                  "    console.log('📬 Messages count:', response.count);",
                  "    if (response.total > 0) {",
                  "        console.log('📋 Latest messages:');",
                  "        response.items.slice(0, 3).forEach((msg, index) => {",
                  "            console.log(`${index + 1}. From: ${msg.From.Mailbox}@${msg.From.Domain}`);",
                  "            console.log(`   To: ${msg.To[0].Mailbox}@${msg.To[0].Domain}`);",
                  "            console.log(`   Subject: ${msg.Content.Headers.Subject ? msg.Content.Headers.Subject[0] : 'No Subject'}`);",
                  "            console.log(`   Date: ${msg.Content.Headers.Date ? msg.Content.Headers.Date[0] : 'No Date'}`);",
                  "            console.log(`   Body: ${msg.Content.Body}`);",
                  "            console.log('---');",
                  "        });",
                  "        // Extract verification codes from email bodies",
                  "        const codes = [];",
                  "        response.items.forEach(msg => {",
                  "            const codeMatch = msg.Content.Body.match(/\\b(\\d{6})\\b/);",
                  "            if (codeMatch) {",
                  "                codes.push(codeMatch[0]);",
                  "            }",
                  "        });",
                  "        if (codes.length > 0) {",
                  "            console.log('🔢 Found verification codes:', codes.join(', '));",
                  "            console.log('💡 Use latest code in verification requests');",
                  "        }",
                  "    } else {",
