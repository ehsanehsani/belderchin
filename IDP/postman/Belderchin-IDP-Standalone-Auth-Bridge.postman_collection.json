    {
      "name": "🔐 4. Auth-Bridge Session Management",
      "description": "Check and manage Auth-Bridge sessions",
      "item": [
        {
          "name": "Check Current Auth-Bridge Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.active) {",
                  "        console.log('✅ AUTH-BRIDGE SESSION ACTIVE');",
                  "        console.log('👤 User ID:', response.identity.id);",
                  "        console.log('📱 Phone:', response.identity.traits.phone);",
                  "        if (response.identity.traits.email) {",
                  "            console.log('📧 Email:', response.identity.traits.email);",
                  "        }",
                  "        console.log('📊 State:', response.identity.state);",
                  "        console.log('🔐 AAL:', response.authenticator_assurance_level);",
                  "        console.log('⏰ Expires:', response.expires_at);",
                  "        console.log('📱 Auth Methods:', JSON.stringify(response.authentication_methods, null, 2));",
                  "        console.log('🎯 STANDALONE AUTH-BRIDGE WORKING!');",
                  "    } else {",
                  "        console.log('❌ NO ACTIVE AUTH-BRIDGE SESSION');",
                  "        console.log('🔄 Please complete Auth-Bridge verification first');",
                  "    }",
                  "} else if (pm.response.code === 401) {",
                  "    console.log('❌ AUTH-BRIDGE SESSION EXPIRED OR INVALID');",
                  "    console.log('🔄 Please complete Auth-Bridge verification again');",
                  "} else {",
                  "    console.log('❌ Failed to check Auth-Bridge session');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authBridgeSessionToken}}"
              }
            ],
            "url": {
              "raw": "{{authBridgeUrl}}/sessions/whoami",
              "host": ["{{authBridgeUrl}}"],
              "path": ["sessions", "whoami"]
            }
          },
          "response": []
