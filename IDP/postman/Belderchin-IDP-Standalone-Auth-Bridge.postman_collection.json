                  "        console.log('1. Is 6-digit code correct?');",
                  "        console.log('2. Did you get code from MailHog?');",
                  "        console.log('3. MailHog URL: http://localhost:8025');",
                  "        console.log('4. Registration ID:', pm.collectionVariables.get('registrationId'));",
                  "        console.log('5. Code format: 6-digit number');",
