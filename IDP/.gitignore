# ===========================================
# 📁 Keep These Files (Exceptions)
# ===========================================
# Important configuration files
!.gitignore
!README.md
!LICENSE
!docker-compose.yml
!*.sln
!*.csproj
!**/Dockerfile

# Documentation
!docs/**/*.md
!postman/**/*.md
!postman/*.postman_collection.json

# Infrastructure files
!infra/**/*.yml
!infra/**/*.yaml
!infra/**/*.json
!infra/**/*.conf
!infra/**/*.sh

# Source code
!**/*.cs
!**/*.js
!**/*.ts
!**/*.json
!**/*.xml
!**/*.md
